<mxfile host="app.diagrams.net"><diagram id="gp-arch" name="GlobalPartners Architecture"><mxGraphModel dx="800" dy="680" grid="1" gridSize="8" guides="1" page="1" pageWidth="800" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="One daily run moves SQL Server data to Streamlit, all inside AWS" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="700" height="24" as="geometry"/></mxCell><mxCell id="sub" value="Bronze, Silver, Gold on S3 built by Glue PySpark; Athena serves the dashboards" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6b6a66;" vertex="1" parent="1"><mxGeometry x="24" y="36" width="700" height="20" as="geometry"/></mxCell><mxCell id="dp" value="Data plane · daily batch in one AWS account" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#c9c7c1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#6b6a66;" vertex="1" parent="1"><mxGeometry x="8" y="64" width="744" height="344" as="geometry"/></mxCell><mxCell id="cp" value="Control plane · orchestrates, secures and monitors" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#efeeeb;strokeColor=#9a9893;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#6b6a66;" vertex="1" parent="1"><mxGeometry x="8" y="440" width="744" height="176" as="geometry"/></mxCell><mxCell id="rds" value="&lt;b&gt;RDS for SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;Express, private subnet&lt;br&gt;order_items, options, date_dim&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24" y="96" width="216" height="72" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;Glue ingest job (PySpark)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;JDBC over SSL, incremental&lt;br&gt;watermark: creation_time_utc&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="272" y="96" width="216" height="72" as="geometry"/></mxCell><mxCell id="bronze" value="&lt;b&gt;S3 Bronze&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;raw Parquet, immutable&lt;br&gt;partitioned by ingest_date&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="520" y="96" width="216" height="72" as="geometry"/></mxCell><mxCell id="silverjob" value="&lt;b&gt;Glue silver job (PySpark)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;DQ rules, dedupe, type casts&lt;br&gt;hash card no., quarantine bad&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="520" y="208" width="216" height="72" as="geometry"/></mxCell><mxCell id="silver" value="&lt;b&gt;S3 Silver (Iceberg)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;clean, conformed tables&lt;br&gt;MERGE upserts, time travel&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="272" y="208" width="216" height="72" as="geometry"/></mxCell><mxCell id="goldjob" value="&lt;b&gt;Glue gold jobs (PySpark)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#1f1e1d&quot;&gt;dims, facts, daily CLV&lt;br&gt;RFM, churn + 4 dashboard marts&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#e6effb;strokeColor=#2f6fd6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="24" y="208" width="216" height="72" as="geometry"/></mxCell><mxCell id="gold" value="&lt;b&gt;S3 Gold (Iceberg)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;star schema + marts&lt;br&gt;tables in Glue Data Catalog&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24" y="320" width="216" height="72" as="geometry"/></mxCell><mxCell id="athena" value="&lt;b&gt;Amazon Athena&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;serverless SQL over Gold&lt;br&gt;KMS-encrypted query results&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="272" y="320" width="216" height="72" as="geometry"/></mxCell><mxCell id="streamlit" value="&lt;b&gt;Streamlit on EC2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;6 dashboard pages via Athena&lt;br&gt;marketing, ops, leadership&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="520" y="320" width="216" height="72" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;daily 6:00 AM ET trigger&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24" y="472" width="216" height="56" as="geometry"/></mxCell><mxCell id="sfn" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;runs jobs, retries, reloads&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="272" y="472" width="216" height="56" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;DynamoDB run control&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;watermarks + step status&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="520" y="472" width="216" height="56" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;CloudWatch + SNS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;logs, metrics, failure alerts&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="24" y="544" width="216" height="56" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b&gt;Secrets Manager + KMS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;rotated creds, encryption keys&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="272" y="544" width="216" height="56" as="geometry"/></mxCell><mxCell id="cicd" value="&lt;b&gt;CI/CD: GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6b6a66&quot;&gt;deploys code + CloudFormation&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=13;fillColor=#ffffff;strokeColor=#9a9893;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="520" y="544" width="216" height="56" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="rds" target="ingest"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="ingest" target="bronze"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="bronze" target="silverjob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="silverjob" target="silver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="silver" target="goldjob"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9a9893;" edge="1" parent="1" source="goldjob" target="gold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=or